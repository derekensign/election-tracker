{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "buildCommand": "",
  "installCommand": "",
  "framework": null,
  "git": { "deploymentEnabled": { "needle-data": false } },
  "functions": { "api/ask.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600" }] },
    { "source": "/geo/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, immutable" }] }
  ]
}
